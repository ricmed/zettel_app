# Copie este arquivo para .env e preencha com suas chaves:
#   cp .env.example .env

# OpenAI (obrigatorio se usar provider openai)
OPENAI_API_KEY=sk-...

# ChromaDB usa esta variavel para embeddings OpenAI
# Se nao definida, o valor de OPENAI_API_KEY sera usado automaticamente
# CHROMA_OPENAI_API_KEY=sk-...

# Anthropic (descomente se usar provider anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
