# Copie para .env e preencha (scripts/setup.ps1 e scripts/setup.sh fazem a copia):
#   cp .env.example .env
# O .env e lido da raiz do projeto ao iniciar; nao e preciso exportar no shell.
# Segredos nunca vao no config/config.yaml.
#
# O config/config.yaml padrao usa QUATRO provedores. Cada chave abaixo diz quais
# fases dependem dela; `zettel doctor` mostra a que falta, fase por fase.
# Para usar menos provedores, troque `llm.<fase>.provider` no config.yaml.

# OpenAI: harvest (bibliografia), review (dedupe), garden, images, summarize.
# Tambem serve aos gateways OpenAI-compatible (vLLM, LM Studio...).
OPENAI_API_KEY=

# Google Gemini: extract (notas de literatura) e o EMBEDDING (busca, connect, garden).
# Sem ela o `zettel init` cria o vault mas nao o indice vetorial. GEMINI_API_KEY tambem vale.
GOOGLE_API_KEY=

# Anthropic: connect (notas permanentes).
ANTHROPIC_API_KEY=

# DeepSeek: ask e article.
DEEPSEEK_API_KEY=

# Senha da interface web (uvicorn zettel.web:app). Sem ela nao ha login.
# Use 32+ caracteres gerados: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Os scripts de setup geram um quando esta vazio.
SESSION_SECRET=

# --- Opcionais ---------------------------------------------------------------

# OpenRouter (provider: openrouter); sem ela, OPENAI_API_KEY e usada.
# OPENROUTER_API_KEY=

# Embedding OpenAI com uma chave separada da do LLM (embedding.provider: openai).
# CHROMA_OPENAI_API_KEY=

# TypeSafe Jev: camada de decisao em modo shadow (decision.* no config.yaml, ADR-055).
# Sem a chave o pipeline segue normal; o shadow so nao registra veredito.
# TYPESAFE_API_KEY=

# YAML alternativo para a interface web (testes, varias instancias).
# ZETTEL_CONFIG=/caminho/para/config.yaml
